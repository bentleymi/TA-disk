{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Linux Disk SMART & NVMe Health Add-on",
    "id": {
      "group": null,
      "name": "TA-disk",
      "version": "1.0.4"
    },
    "author": [{"name":"Michael \"JKat54\" Bentley","email":"michael@bentleypc.com","company":"BentleyPC LLC"}],
    "releaseDate": "11/16/2026",
    "description": "Collects disk health from smartctl (SATA/ATA SMART + NVMe) and /sys/class/nvme: health status, power-on hours, temperature, NVMe wear (percentage used, available spare), media errors and SMART raw counters (reallocated, uncorrected, CRC). Emits per-disk JSON events to index=main (sourcetype disk:status) and numeric disk.<device>.<attribute> metrics to index=metrics (sourcetype disk:metrics), with overview and metrics dashboards.",
